# ════════════════════════════════════════════════════════════════
# zhishu VPS 部署环境变量模板（.env.example）
# ════════════════════════════════════════════════════════════════
# 用法：
#   cp .env.example .env
#   vim .env          # 填入真实值
#   ./deploy-vps.sh up
#
# 🔑 变量名与 application.yml 中的 ${} 引用完全一致！

# ====== 基础运行参数 ======
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081
TZ=Asia/Shanghai

# 宿主机暴露端口（仅绑定 127.0.0.1，由 Nginx / 1Panel 反代）
ZHISHU_BACKEND_PORT=8080
ZHISHU_ES_PORT=9200

# ====== 资源与日志控制 ======
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=55.0 -XX:InitialRAMPercentage=20.0
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
ZHISHU_BACKEND_MEM_LIMIT=768m
ZHISHU_ES_MEM_LIMIT=1400m
ZHISHU_KAFKA_MEM_LIMIT=512m
ZHISHU_ES_HEAP=768m
KAFKA_LOG_RETENTION_HOURS=24
KAFKA_LOG_RETENTION_BYTES=536870912

# ====== MySQL（1Panel 已有）======
SPRING_DATASOURCE_URL=jdbc:mysql://172.17.0.1:3306/zhishu?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password
DB_POOL_MAX_SIZE=20

# ====== Redis（1Panel 已有）======
SPRING_DATA_REDIS_HOST=172.17.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=your_redis_password
SPRING_DATA_REDIS_DATABASE=2

# ====== Kafka（compose 内置）======
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_KAFKA_TOPIC_PARTITIONS=1
SPRING_KAFKA_TOPIC_REPLICATION_FACTOR=1

# ====== MinIO（1Panel 已有）======
MINIO_ENDPOINT=http://172.17.0.1:9000
MINIO_ACCESS_KEY=your_minio_ak
MINIO_SECRET_KEY=your_minio_sk
MINIO_BUCKET_NAME=zhishu-uploads
MINIO_PUBLIC_URL=https://oss.yourdomain.com

# ====== Elasticsearch（compose 内置）======
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_es_password
ELASTICSEARCH_INSECURE_TRUST_ALL_CERTIFICATES=false
ELASTICSEARCH_INIT_ENABLE=true

# ====== JWT（openssl rand -base64 32 生成）======
JWT_SECRET_KEY=your_base64_jwt_secret

# ====== 管理员（首次启动自动创建，已有管理员则跳过）======
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=your_admin_password
ADMIN_BOOTSTRAP_PRIMARY_ORG=default
ADMIN_BOOTSTRAP_ORG_TAGS=default,admin

# ====== 注册模式 ======
APP_AUTH_REGISTRATION_MODE=INVITE_ONLY

# ====== 跨域白名单（填你的实际域名）======
SECURITY_ALLOWED_ORIGINS=https://yourdomain.com

# ====== AI 服务 ======
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_API_MODEL=deepseek-chat
DEEPSEEK_API_KEY=your_deepseek_key
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_MODEL=text-embedding-v4
EMBEDDING_API_KEY=your_embedding_key

# ====== 微信支付（不用先设 false）======
WX_PAY_ENABLE=false
WX_PAY_APP_ID=
WX_PAY_MERCHANT_ID=
WX_PAY_PRIVATE_KEY=
WX_PAY_MERCHANT_SERIAL_NUMBER=
WX_PAY_API_V3_KEY=
WX_PAY_NOTIFY_URL=
WX_PAY_REFUND_NOTIFY_URL=
