# backend service base url, prod environment
VITE_SERVICE_BASE_URL=/api/v1
# other backend service base url, prod environment
VITE_OTHER_SERVICE_BASE_URL={"api":"/api/v1","ws":"/proxy-ws"}
# production must use static route mode, backend does not provide /route/getConstantRoutes
VITE_AUTH_ROUTE_MODE=static
VITE_BASE_URL=/
VITE_SOURCE_MAP=N
VITE_HTTP_PROXY=N
VITE_PROXY_LOG=N
VITE_ICON_PREFIX=icon
VITE_ICON_LOCAL_PREFIX=local-icon
VITE_SERVICE_SUCCESS_CODE=200
